# Salin ke `.env` lalu isi dari Supabase Dashboard → Project Settings → API.
# Mode online otomatis nonaktif kalau kedua nilai ini kosong.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Voice chat (opsional) ---------------------------------------------------
# Tanpa TURN, voice chat pakai STUN publik saja — jalan untuk mayoritas jaringan
# (rumah / sekolah 1 WiFi). Untuk jaringan ketat (NAT simetris), isi kredensial
# TURN di bawah (mis. Metered.ca free tier, Twilio, atau coturn di Railway).
# VITE_TURN_URL boleh > 1 URL dipisah koma, mis:
#   turn:turn.contoh.com:3478?transport=udp,turn:turn.contoh.com:443?transport=tcp
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
